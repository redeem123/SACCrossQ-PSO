\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Taxonomy of PSO parameter control methods. Static approaches use fixed parameters throughout optimization. Time-varying schedules adjust parameters based on iteration count. Adaptive methods use swarm feedback (fitness-based, evolutionary state) or learned policies (reinforcement learning). APEXPSO (highlighted) combines SAC with CrossQ optimizations and transformer-based state encoding to advance RL-based adaptive control.}}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pso_taxonomy}{{1}{4}{Taxonomy of PSO parameter control methods. Static approaches use fixed parameters throughout optimization. Time-varying schedules adjust parameters based on iteration count. Adaptive methods use swarm feedback (fitness-based, evolutionary state) or learned policies (reinforcement learning). APEXPSO (highlighted) combines SAC with CrossQ optimizations and transformer-based state encoding to advance RL-based adaptive control}{figure.caption.1}{}}
