\newlabel{sec:results}{{}{10}{}{Item.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Performance comparison of RL-based algorithms across three scenarios. Three RL frameworks are compared: RLAMPSO (DDPG-based), DQN-PSO (Q-learning-based), and APEXPSO (SAC-based), each evaluated with three parameter granularity modes (Global, 5-Subgroup, Per-Particle). Results show mean, standard deviation, minimum, and maximum global best fitness over 30 independent runs per scenario. Lower fitness values indicate better path quality. Bold values indicate best performance in each column.}}{10}{table.caption.3}\protected@file@percent }
\newlabel{tab:rl_comparison}{{1}{10}{Performance comparison of RL-based algorithms across three scenarios. Three RL frameworks are compared: RLAMPSO (DDPG-based), DQN-PSO (Q-learning-based), and APEXPSO (SAC-based), each evaluated with three parameter granularity modes (Global, 5-Subgroup, Per-Particle). Results show mean, standard deviation, minimum, and maximum global best fitness over 30 independent runs per scenario. Lower fitness values indicate better path quality. Bold values indicate best performance in each column}{table.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Ablation study results showing Mean $\pm $ Standard Deviation. Statistical significance versus the Full Baseline (paired t-test) is denoted by $^{*}$ ($p < 0.05$) and $^{**}$ ($p < 0.01$). In Scenario 3, while 'No Attention' achieves lower fitness (due to penalty bias), the 'S3 Path Length' column confirms it produces significantly longer, less efficient trajectories ($p=0.002$).}}{11}{table.caption.4}\protected@file@percent }
\newlabel{tab:ablation_run}{{2}{11}{Ablation study results showing Mean $\pm $ Standard Deviation. Statistical significance versus the Full Baseline (paired t-test) is denoted by $^{*}$ ($p < 0.05$) and $^{**}$ ($p < 0.01$). In Scenario 3, while 'No Attention' achieves lower fitness (due to penalty bias), the 'S3 Path Length' column confirms it produces significantly longer, less efficient trajectories ($p=0.002$)}{table.caption.4}{}}
